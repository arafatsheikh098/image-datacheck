<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>imagedatacheck report — {{ result.root }}</title>
<style>
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; margin: 2rem auto; max-width: 1100px; padding: 0 1rem; color: #1a1a1a; }
  h1 { font-size: 1.4rem; margin-bottom: 0.2rem; }
  h2 { font-size: 1.1rem; margin-top: 2rem; border-bottom: 1px solid #ccc; padding-bottom: 0.3rem; }
  table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
  th, td { text-align: left; padding: 0.4rem 0.6rem; border-bottom: 1px solid #eee; vertical-align: top; }
  th { background: #f6f6f6; }
  .severity-error { color: #c0392b; font-weight: bold; }
  .severity-warning { color: #b58900; }
  .severity-info { color: #268bd2; }
  .thumb { max-width: 96px; max-height: 96px; border: 1px solid #ddd; }
  .meta { color: #666; font-size: 0.9rem; }
  .counts span { margin-right: 1rem; }
  code { background: #f0f0f0; padding: 0.1em 0.3em; border-radius: 3px; }
  ul.files { margin: 0; padding-left: 1.2rem; }
</style>
</head>
<body>
<header>
  <h1>imagedatacheck report</h1>
  <div class="meta">
    <div><strong>Root:</strong> <code>{{ result.root }}</code></div>
    <div><strong>Layout:</strong> {{ result.layout.value }}</div>
    <div><strong>Files scanned:</strong> {{ files_count }}</div>
    <div><strong>Findings:</strong> {{ findings_count }}</div>
    <div><strong>Schema version:</strong> {{ schema_version }}</div>
  </div>
  <div class="counts">
    {% for sev in ['error', 'warning', 'info'] %}
      {% if counts.get(sev, 0) %}
        <span class="severity-{{ sev }}">{{ sev }}: {{ counts[sev] }}</span>
      {% endif %}
    {% endfor %}
  </div>
</header>

<h2>Findings</h2>
{% if findings %}
<table>
  <thead>
    <tr>
      <th>Severity</th>
      <th>Code</th>
      <th>Message</th>
      <th>Files</th>
      <th>Sample</th>
    </tr>
  </thead>
  <tbody>
  {% for f in findings %}
    <tr>
      <td class="severity-{{ f.severity }}">{{ f.severity }}</td>
      <td><code>{{ f.code }}</code></td>
      <td>{{ f.message }}</td>
      <td>
        {% if f.files %}
          <ul class="files">
          {% for p in f.files[:5] %}
            <li><code>{{ p }}</code></li>
          {% endfor %}
          {% if f.files|length > 5 %}
            <li><em>… and {{ f.files|length - 5 }} more</em></li>
          {% endif %}
          </ul>
        {% else %}
          —
        {% endif %}
      </td>
      <td>
        {% if f.thumbnail %}
          <img class="thumb" alt="" src="{{ f.thumbnail }}">
        {% else %}
          —
        {% endif %}
      </td>
    </tr>
  {% endfor %}
  </tbody>
</table>
{% else %}
<p>No findings.</p>
{% endif %}

</body>
</html>
